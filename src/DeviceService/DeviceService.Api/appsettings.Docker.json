{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Information",
      "MassTransit": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DeviceDatabase": "Host=device-db;Port=5432;Database=device_db;Username=device_user;Password=device_password"
  },
  "Jwt": {
    "Issuer": "https://identity-service",
    "Audience": "SmartInventory.Api",
    "SigningKey": "SmartInventory-Docker-Signing-Key-2026"
  },
  "InventoryService": {
    "BaseUrl": "http://inventory-service:8080"
  },
  "DeviceService": {
    "BaseUrl": "http://device-service:8080",
    "OfflineThresholdSeconds": 300,
    "OfflineDetectionIntervalSeconds": 60,
    "Simulator": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "DeviceId": null
    }
  },
  "RabbitMQ": {
    "Enabled": true,
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  }
} 